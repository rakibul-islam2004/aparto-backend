# App Configuration
PORT=4000
NODE_ENV=development

# Database
# Example NeonDB connection string (ensure `sslmode=require`):
# postgresql://<user>:<password>@<your-neon-host>.neon.tech:5432/<database>?sslmode=require
# Replace with your Neon connection details or set `DATABASE_URL` in your deployment environment.
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech:5432/aparto?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# SSLCommerz
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_IS_SANDBOX=true

# Steadfast Courier
STEADFAST_API_KEY=your-steadfast-api-key
STEADFAST_SECRET_KEY=your-steadfast-secret-key
STEADFAST_IS_SANDBOX=true

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=aparto-uploads
R2_PUBLIC_URL=https://your-r2-public-url
